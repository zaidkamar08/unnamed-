int n;
int t[1001][201];
int solve(int ind,vector<int>&nums,int target){
    if(target==0) return 1;
    if(target<0 || ind>=n) return 0;

    if(t[target][ind]!=-1){
        return t[target][ind];
    }
    int acc_target=solve(0,nums,target-nums[ind]);
    int rej_target=solve(ind+1,nums,target);
    return t[target][ind]=acc_target+rej_target;

    
}
